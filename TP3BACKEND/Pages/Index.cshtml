@page
@model SistemaAcademia.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Gestão de Alunos";
}

<div class="container mt-4">
    <h2 class="mb-3">Cadastrar Novo Aluno</h2>

    <form method="post" class="card p-4 mb-5 shadow-sm">
        <div class="mb-3">
            <label class="form-label">Matrícula:</label>
            <input type="number" asp-for="NovoAluno.Matricula" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Nome:</label>
            <input type="text" asp-for="NovoAluno.Nome" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">CPF:</label>
            <input type="text" asp-for="NovoAluno.Cpf" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Gravar no Arquivo CSV</button>
    </form>

    <h2 class="mb-3">Alunos Registados no Sistema</h2>
    <p class="text-muted">Dados lidos diretamente do ficheiro .csv</p>

    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Matrícula</th>
                <th>Nome</th>
                <th>CPF</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Alunos != null)
            {
                @foreach (var aluno in Model.Alunos)
                {
                    <tr>
                        <td>@aluno.Matricula</td>
                        <td>@aluno.Nome</td>
                        <td>@aluno.Cpf</td>
                        <td>
                            @if (aluno.StatusAtivo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inativo</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>